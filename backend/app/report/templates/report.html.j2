{% for b in sm.scenarios.B.buildings if b.kind == 'MAIN' %}<tr><td>{{ b.id }}</td><td class="r">{{ b.floors }}</td><td class="r">{{ b.height_m|n(1) }}</td><td class="r">{{ b.base_z|n(2) }}</td><td class="r">{{ b.top_z|n(2) }}</td><td>{{ b.centroid[0]|round(1) }}, {{ b.centroid[1]|round(1) }}</td><td>{{ '변경' if b.id in sm.changed_buildings else '-' }}</td></tr>{% endfor %}
