<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta.title }} · {{ meta.run_id }}</title>
<style>
:root{--ink:#0b0b0b;--ink2:#52514e;--muted:#898781;--line:#e1e0d9;--axis:#c3c2b7;--a:#2a78d6;--b:#eb6834;--bad:#c0392b;--good:#1c5cab;--warnbg:#fff6e0;--plane:#f9f9f7;--accent:#0d366b}
@page{size:A4;margin:16mm 14mm}
*{box-sizing:border-box}
html{background:#e9e8e3}
body{font-family:"Noto Sans KR","Noto Sans CJK KR","Malgun Gothic","Apple SD Gothic Neo",sans-serif;color:var(--ink);font-size:9.6pt;line-height:1.55;margin:0;background:#fff;
  -webkit-print-color-adjust:exact;print-color-adjust:exact;word-break:keep-all}
main{max-width:182mm;margin:0 auto;padding:10mm 0;background:#fff}
@media screen{main{padding:14mm 16mm;margin:16px auto;box-shadow:0 1px 6px rgba(0,0,0,.12)} .screenbar{position:sticky;top:0;background:#0d366b;color:#fff;padding:8px 16px;font-size:13px;z-index:5;display:flex;gap:16px;justify-content:space-between}}
@media print{.screenbar{display:none} main{padding:0;max-width:none}}
h1{font-size:21pt;line-height:1.3;margin:0 0 6mm;color:var(--accent)}
h2{font-size:14pt;color:var(--accent);border-bottom:1.5pt solid var(--accent);padding-bottom:1.5mm;margin:0 0 4mm;break-after:avoid}
h3{font-size:11pt;margin:5mm 0 2mm;color:var(--ink);break-after:avoid}
h4{font-size:9.8pt;margin:3mm 0 1.5mm;break-after:avoid}
section.chapter{break-before:page}
p{margin:0 0 2.2mm}
table{width:100%;border-collapse:collapse;margin:2mm 0 4mm;font-size:8.2pt;font-variant-numeric:tabular-nums}
th,td{border-bottom:0.5pt solid var(--line);padding:1.2mm 1.6mm;text-align:left;vertical-align:top}
th{background:#f2f1ec;font-weight:700;color:var(--ink2)}
td.r,th.r{text-align:right}
thead{display:table-header-group}
tr{break-inside:avoid}
caption{caption-side:top;text-align:left;font-weight:700;font-size:8.6pt;color:var(--ink2);padding-bottom:1mm}
figure{margin:3mm 0 5mm;break-inside:avoid;text-align:center}
figure svg{max-width:100%;height:auto}
figcaption{font-size:8.2pt;color:var(--ink2);margin-top:1.2mm;text-align:left}
.badge{display:inline-block;border:0.6pt solid currentColor;border-radius:2pt;padding:0 1.4mm;font-size:7.6pt;font-weight:700;margin-right:1mm}
.b-syn{color:#a15c00}.b-real{color:#0b6b48}.b-der{color:#4a3aa7}.b-warn{color:#b03a2e}.b-up{color:#1c5cab}
.note{background:var(--plane);border-left:2pt solid var(--axis);padding:2mm 3mm;margin:2mm 0 4mm;font-size:8.6pt;color:var(--ink2)}
.warn{background:var(--warnbg);border-left:2pt solid #eda100;padding:2mm 3mm;margin:2mm 0 4mm;font-size:8.6pt}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:2.5mm;margin:3mm 0 4mm}
.kpi{border:0.6pt solid var(--line);border-radius:2pt;padding:2.4mm 3mm;break-inside:avoid}
.kpi .l{font-size:7.6pt;color:var(--ink2)}.kpi .v{font-size:14pt;font-weight:700;font-variant-numeric:tabular-nums}.kpi .s{font-size:7.4pt;color:var(--muted)}
.neg{color:var(--bad)}.pos{color:var(--good)}
.pass{color:#0b6b48;font-weight:700}.fail{color:var(--bad);font-weight:700}
.cover{height:257mm;display:flex;flex-direction:column;justify-content:space-between;break-after:page}
.cover .brand{font-weight:700;letter-spacing:.12em;color:var(--accent);font-size:10pt}
.cover .stamp{border:1.5pt solid var(--bad);color:var(--bad);font-weight:800;display:inline-block;padding:2mm 4mm;font-size:12pt;transform:rotate(-2deg)}
.cover dl{display:grid;grid-template-columns:38mm 1fr;gap:1.6mm 4mm;font-size:9.6pt;margin:0}
.cover dt{color:var(--ink2)}.cover dd{margin:0;font-weight:500}
.toc{break-after:page}
.toc ol{list-style:none;padding:0;margin:0}
.toc li{display:flex;justify-content:space-between;border-bottom:0.4pt dotted var(--axis);padding:1.6mm 0;font-size:10pt}
ul.tight{margin:0 0 3mm;padding-left:5mm}ul.tight li{margin-bottom:1mm}
.mono{font-family:Consolas,"D2Coding",monospace;font-size:7.6pt;word-break:break-all}
.small{font-size:7.8pt;color:var(--ink2)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:4mm}
</style>
</head>
<body>
{% set ns = namespace(f=0, t=0) %}
{% macro fig(svg, cap) -%}{% set ns.f = ns.f + 1 %}<figure>{{ svg|safe }}<figcaption><b>그림 {{ ns.f }}.</b> {{ cap }}</figcaption></figure>{%- endmacro %}
{% macro tcap(text) -%}{% set ns.t = ns.t + 1 %}<caption>표 {{ ns.t }}. {{ text }}</caption>{%- endmacro %}
{% macro cls(v) -%}{% if v is number and v < 0 %}neg{% elif v is number and v > 0 %}pos{% endif %}{%- endmacro %}
{% macro dc(c) -%}{% if c == 'SYNTHETIC' %}<span class="badge b-syn">SYNTHETIC 가상</span>{% elif c == 'REAL_OFFICIAL' %}<span class="badge b-real">REAL_OFFICIAL</span>{% elif c == 'DERIVED' %}<span class="badge b-der">DERIVED</span>{% elif c == 'USER_UPLOADED' %}<span class="badge b-up">USER_UPLOADED</span>{% else %}<span class="badge">{{ c }}</span>{% endif %}{%- endmacro %}
<div class="screenbar"><span>{{ meta.title }} · 보고서 {{ meta.report_id }} · v{{ meta.version }} (읽기 전용 스냅샷)</span><span>가상 PoC</span></div>
<main>

<!-- ============================== 표지 ============================== -->
<section class="cover">
  <div>
    <div class="brand">JIRISO DATA STUDIO</div>
    <div style="height:28mm"></div>
    <h1>{{ meta.title }}</h1>
    <p style="font-size:12pt;color:var(--ink2)">공동주택 설계변경 전후 (A) 직사일조시간 · (B) 그림자 변화 · (C) 건축물 이격거리 분석</p>
    <div style="height:8mm"></div>
    <span class="stamp">가상 PoC · 실제 LH 설계안 아님</span>
  </div>
  <dl>
    <dt>프로젝트</dt><dd>{{ meta.project_name }}</dd>
    <dt>분석 대상 지역</dt><dd>{{ site.district }}<br><span class="small">대표점: {{ site.official_address }} (LH 공고 지도 마커, 경계 미검증)</span></dd>
    <dt>설계 시나리오</dt><dd>A: {{ sm.scenarios.A.name }} (rev {{ sm.scenarios.A.revision }})<br>B: {{ sm.scenarios.B.name }} (rev {{ sm.scenarios.B.revision }})</dd>
    <dt>분석일·시간</dt><dd>{{ sm.params.date }} {{ sm.params.start }}~{{ sm.params.end }} ({{ sm.params.timezone }}, 표준시 KST=UTC+9, 간격 {{ sm.params.interval_min }}분)</dd>
    <dt>분석 항목</dt><dd>{{ sm.analysis_type }} {% if sm.analysis_type == 'ALL' %}(A·B·C 전체){% endif %}</dd>
    <dt>보고서 작성일</dt><dd>{{ meta.generated_at }}</dd>
    <dt>보고서 ID / 버전</dt><dd>{{ meta.report_id }} / v{{ meta.version }}</dd>
    <dt>발행 주체</dt><dd>{{ meta.publisher }}</dd>
  </dl>
  <div class="warn"><b>중요 고지.</b> {{ disclaimer }} 지형은 {% if sm.terrain.data_class == 'SYNTHETIC' %}<b>합성(SYNTHETIC) 30 m DEM</b>으로 실제 지역 지형이 아니며{% else %}사용자 업로드 DEM이며{% endif %}, 계획지반은 가상 지반 가정입니다. 법규 적합/위반 판정을 하지 않습니다.</div>
</section>

<!-- ============================== 목차 ============================== -->
<section class="toc">
  <h2 style="border:none">목차</h2>
  <ol>
  {% for sid, title in sections %}<li><span>{{ title }}</span><span>{{ toc_pages.get(title, '…') }}</span></li>{% endfor %}
  </ol>
  <p class="small" style="margin-top:6mm">쪽번호는 1차 렌더링된 PDF에서 각 장 제목의 실제 위치를 추출하여 기입했습니다. 표·그림 번호는 본문 순서대로 부여됩니다. 요구 17개 항목(표지 포함)과 장의 대응은 16장 부록 표에 있습니다.</p>
</section>

<!-- ============================== 1 문서관리 ============================== -->
<section class="chapter" id="s01">
<h2>1. 문서관리</h2>
<table>{{ tcap("문서 식별 정보") }}
<tbody>
<tr><th style="width:42mm">보고서 ID</th><td class="mono">{{ meta.report_id }}</td></tr>
<tr><th>Analysis run ID</th><td class="mono">{{ meta.run_id }}</td></tr>
<tr><th>문서 버전</th><td>v{{ meta.version }} (동일 run의 성공 보고서 순번 기반)</td></tr>
<tr><th>생성 시각</th><td>{{ meta.generated_at }} ({{ meta.generated_at_utc }} UTC)</td></tr>
<tr><th>분석 엔진</th><td>{{ meta.engine }} v{{ meta.engine_version }} · 알고리즘 {{ meta.algorithm_version }} · 광선엔진 {{ sm.provenance.raycast_engine }}</td></tr>
<tr><th>코드 commit</th><td class="mono">{{ meta.commit }}</td></tr>
<tr><th>Cache key</th><td class="mono">{{ sm.provenance.cache_key }}</td></tr>
<tr><th>지형 입력 해시 (SHA-256)</th><td class="mono">{{ sm.provenance.input_hashes.terrain_sha256 }}</td></tr>
<tr><th>형상 해시 A / B</th><td class="mono">{{ sm.provenance.input_hashes.geometry_hash_a }}<br>{{ sm.provenance.input_hashes.geometry_hash_b }}</td></tr>
<tr><th>시나리오 해시 A / B</th><td class="mono">{{ sm.provenance.input_hashes.scenario_hash_a }}<br>{{ sm.provenance.input_hashes.scenario_hash_b }}</td></tr>
<tr><th>검증 상태</th><td>{% if qa.critical_fail %}<span class="fail">QA 치명 실패 {{ qa.critical_fail|length }}건</span>{% else %}<span class="pass">자동 QA 치명 항목 전부 통과</span>{% endif %} (통과 {{ qa.n_pass }} / 실패 {{ qa.n_fail }}) · 상태 {{ qa.verification_status }}</td></tr>
<tr><th>분석 처리시간</th><td>{{ meta.processing_s|n(1) }} s (민감도 재계산 포함)</td></tr>
</tbody></table>
<table>{{ tcap("문서 개정 기록") }}
<thead><tr><th>버전</th><th>일시</th><th>내용</th></tr></thead>
<tbody><tr><td>v{{ meta.version }}</td><td>{{ meta.generated_at }}</td><td>분석 run {{ meta.run_id }} 스냅샷으로부터 자동 생성 (수정 불가 스냅샷)</td></tr></tbody></table>
<div class="note">본 문서는 분석 실행 시점에 고정된 입력 스냅샷과 결과 파일(analysis_summary.json, quality_check.json)로부터 결정론적으로 생성되었습니다. 변경안 B가 이후 수정되어도 본 보고서와 그 수치는 바뀌지 않으며, 수정된 시나리오는 새 해시·새 run으로 관리됩니다. LLM이나 외부 네트워크를 사용하지 않았습니다.</div>
</section>

<!-- ============================== 2 요약 ============================== -->
<section class="chapter" id="s02">
<h2>2. 요약 (Executive Summary)</h2>
<div class="kpis">
{% if sm.A %}
<div class="kpi"><div class="l">A. 일조 감소 수광점</div><div class="v neg">{{ "{:,}".format(sm.A.n_decreased) }}</div><div class="s">비교 {{ "{:,}".format(sm.A.n_common) }}개 중 · 증가 {{ "{:,}".format(sm.A.n_increased) }}</div></div>
<div class="kpi"><div class="l">A. 최대 직사일조 감소</div><div class="v neg">{{ sm.A.delta_total_min_min|n(0) }}분</div><div class="s">평균 {{ sm.A.mean_total_min_a|n(1) }} → {{ sm.A.mean_total_min_b|n(1) }}분</div></div>
{% endif %}
{% if sm.B %}
<div class="kpi"><div class="l">B. 최대 신규 음영면적</div><div class="v neg">{{ sm.B.max_new_shade_area_m2|n(0) }} m²</div><div class="s">{{ sm.B.max_new_shade_time }} KST · 유효 {{ sm.B.valid_area_m2|n(0) }} m²</div></div>
<div class="kpi"><div class="l">B. 누적 음영 증가 면적</div><div class="v">{{ sm.B.area_more_shade_m2|n(0) }} m²</div><div class="s">감소 면적 {{ sm.B.area_less_shade_m2|n(0) }} m²</div></div>
{% endif %}
{% if sm.C and sm.C.min_pair_a %}
<div class="kpi"><div class="l">C. 최소 이격 A → B</div><div class="v">{{ sm.C.min_pair_a.distance_m|n(2) }} → {{ sm.C.min_pair_b.distance_m|n(2) }} m</div><div class="s">{{ sm.C.min_pair_b.pair_id|replace('|','↔') }}</div></div>
<div class="kpi"><div class="l">C. 이격 감소 건물쌍</div><div class="v">{{ sm.C.n_worsened }}쌍</div><div class="s">증가 {{ sm.C.n_improved }} · 접촉/중첩 {{ sm.C.n_contact_or_overlap_b }}</div></div>
{% endif %}
</div>
<h3>핵심 결과 (계산값)</h3>
<ul class="tight">{% for s in exec %}<li>{{ s }}</li>{% endfor %}</ul>
<h3>검토 우선 항목</h3>
<table>{{ tcap("검토 우선순위 요약 (상세는 12장)") }}
<thead><tr><th>구분</th><th>대상</th><th>근거(계산값)</th></tr></thead><tbody>
{% for r in recs[:6] %}<tr><td>{{ r.level }}</td><td>{{ r.target }}</td><td>{{ r.basis }}</td></tr>{% endfor %}
</tbody></table>
<h3>해석상 주의사항</h3>
<ul class="tight">
<li>직사일조는 <b>기하학적 직사일조 가능 시간</b>입니다. 구름·기상, 일사에너지, 실내 조도, 세대별 일조권을 의미하지 않습니다.</li>
<li>수광점은 실제 창호가 아닌 <b>외벽 대리지점(facade_proxy)</b>이며, 분석 메쉬에 포함된 차폐물만 반영합니다(coverage flag: {{ sm.coverage.flag }}).</li>
<li>지형은 {% if sm.terrain.data_class == 'SYNTHETIC' %}합성 30 m DEM(실제 인천계양 지형 아님){% else %}업로드 30 m DEM{% endif %}, 계획지반은 가상 평탄 지반 가정입니다.</li>
<li>이격거리는 수평 최단거리 등 기하 계측값이며 건축법 제61조·시행령 제86조 등 법정 이격 적합성은 판정하지 않습니다.</li>
</ul>
</section>

<!-- ============================== 3 배경 ============================== -->
<section class="chapter" id="s03">
<h2>3. 분석 배경과 목적</h2>
<p>본 분석은 동일한 대지·지형·주변 조건에서 기준안 A와 설계변경안 B의 주동 배치(이동·회전·층수)를 비교하여, 변경이 (A) 주동 외벽 수광점의 직사일조 가능 시간, (B) 단지 지표면의 음영 분포와 지속시간, (C) 주동 간 수평 이격거리에 미치는 변화를 정량화하는 것을 목적으로 합니다. 모든 수치는 Python 분석엔진의 3D 광선교차 및 평면 기하 연산에서 산출되었으며, 웹 3D 화면의 렌더링 그림자 픽셀은 수치로 사용하지 않았습니다.</p>
<div class="two">
<div><h4>이 결과로 판단할 수 있는 것</h4><ul class="tight">
<li>설계변경으로 직사일조가 줄거나 늘어난 주동·층·외벽 위치와 그 크기(분)</li>
<li>변경으로 새로 생기거나 해소된 지표면 음영의 위치·면적·시간대</li>
<li>가상 놀이터·휴게공간의 음영 지속시간 변화</li>
<li>주동 쌍별 최단 이격거리 증감과 최근접 위치</li>
<li>추가 검토가 필요한 위치의 우선순위</li></ul></div>
<div><h4>판단할 수 없는 것</h4><ul class="tight">
<li>실제 LH 설계안·실제 세대의 일조 성능 및 일조권 침해 여부</li>
<li>건축법·조례상 일조/이격 기준 적합 여부, 인허가 가능성</li>
<li>기상(구름)을 고려한 일조시간, 일사량, 실내 채광·조도, 에너지</li>
<li>모델 범위 밖 실제 건물·수목·산지에 의한 차폐</li>
<li>30 m DEM의 수직 정확도를 넘어서는 지형 정밀 효과</li></ul></div>
</div>
</section>

<!-- ============================== 4 지역·대상 ============================== -->
<section class="chapter" id="s04">
<h2>4. 대상 지역 및 대상 주동</h2>
<table>{{ tcap("대상지 위치 근거") }}<tbody>
<tr><th style="width:40mm">지구</th><td>{{ site.district }}</td></tr>
<tr><th>공식 위치 근거</th><td>LH 청약플러스 「인천계양 A2블록 공공분양주택 입주자모집공고」 소재지 {{ site.official_address }}, 지도 마커 좌표 ({{ site.lat0 }}, {{ site.lon0 }}) {{ dc('REAL_OFFICIAL') }}<br><span class="small">{{ lh_url }} (접근 {{ site.location_source.accessed }})</span></td></tr>
<tr><th>교차확인</th><td>{{ site.location_source.cross_check.source }} ({{ site.location_source.cross_check.lat }}, {{ site.location_source.cross_check.lon }}) – 법정동 중심점이며 블록 위치 아님</td></tr>
<tr><th>지구/블록 경계</th><td>{{ site.boundary_status }} {{ dc('SYNTHETIC') }}</td></tr>
<tr><th>개략 위치 여부</th><td>approximate_demo_location = {{ site.approximate_demo_location|lower }} (대표점은 공식 페이지에서 확인, 경계·배치는 가상)</td></tr>
<tr><th>후속 후보지</th><td>{{ site.follow_up_candidate }}</td></tr>
</tbody></table>
{{ fig(figs.location, "대상지 대표점, 가상 대상지(300 m), 가상 계획지반(초록), 지형 모델 영역(점선). 배경지도 없음(자체 생성 정적 지도).") }}
