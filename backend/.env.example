# Copy to backend/.env (never commit the real file)
# Railway Redis public URL (TCP proxy):  redis://default:<password>@<host>.proxy.rlwy.net:<port>/0
REDIS_URL=
# rq (Redis + RQ worker) | thread (no Redis, in-process fallback)
JOB_BACKEND=rq
# Optional: PostgreSQL/PostGIS instead of the local SQLite default
# DATABASE_URL=postgresql+psycopg2://geobuild:geobuild@localhost:5432/geobuild
FRONTEND_URL=http://127.0.0.1:5173
